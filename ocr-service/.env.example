# OCR engine: "tesseract" (local/self-hosted, default) or "vision" (Google Cloud Vision).
OCR_ENGINE=tesseract

# Tesseract language(s), e.g. "eng" or "eng+hin".
TESSERACT_LANG=eng

# Optional explicit path to the tesseract binary (else it must be on PATH).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Max pages to OCR from a single PDF (protects against huge files).
MAX_PDF_PAGES=15

# Rendering DPI for PDF pages before OCR (higher = slower, more accurate).
PDF_RENDER_DPI=200

# Only for OCR_ENGINE=vision: path to a GCP service-account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-vision.json

# Optional shared secret; if set, callers must send header  X-OCR-Token: <value>
# OCR_SHARED_SECRET=change-me
