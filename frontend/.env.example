# ClaimLens frontend — environment template. Copy to `.env.local` for local dev.
#
# EVERY variable here is prefixed NEXT_PUBLIC_, which means Next.js inlines it into the JavaScript
# bundle shipped to the browser. Anyone can read them with devtools.
# => NEVER put a secret in this file. No API keys, no database passwords, no Resend/Gemini keys.
#    Those belong on the backend only, where they stay server-side.

# --- Where the backend API lives (include the /api/v1 path) ---
# Local:  http://localhost:8080/api/v1
# Deploy: https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# --- Google sign-in ---
# The OAuth *client id* only — it is public by design (it appears in the sign-in URL). The client
# SECRET is never used here. Leave blank to hide the "Sign in with Google" button entirely.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Canonical site URL, used for SEO metadata (OpenGraph / Twitter cards) ---
# Set this to your deployed frontend domain. If unset it falls back to a placeholder, and link
# previews shared on social media will point at the wrong domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Show the one-click demo-account panel on the sign-in page ---
# "false" hides it. Keep it on for a portfolio demo so reviewers can sign in without credentials.
NEXT_PUBLIC_DEMO=true
