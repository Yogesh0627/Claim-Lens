# ClaimLens backend — environment template.
# Copy to `.env` (gitignored) and fill in real values, or export these in your shell.
# application.properties reads these via ${VAR} placeholders; secrets are NOT committed.

# --- Database ---
# DATABASE_PASSWORD has no default on purpose: the app fails fast if it is unset,
# rather than silently booting on a stale/wrong secret.
DATABASE_URL=jdbc:postgresql://localhost:5432/claimlens_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_postgres_password

# --- JWT (>= 32 bytes for HS256) ---
JWT_SECRET=change-me-to-a-256-bit-random-secret
# JWT_EXPIRATION=PT15M
# JWT_REFRESH_EXPIRATION=P7D

# --- CORS (frontend origin[s], comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend URL used to build links inside emails (invitation / password reset) ---
# Must point at the UI, not the API. Set this to your deployed frontend domain in production, or
# every emailed "set your password" link will point at localhost and be useless to the recipient.
APP_BASE_URL=http://localhost:3000

# --- Cache / Redis ---
# Local dev caches in-process with Caffeine — nothing to set here. In production, activate the
# `prod` profile to swap the cache backend to Redis (Upstash). Keys are namespaced "claimlens:"
# so one Upstash account can be shared across apps.
#   SPRING_PROFILES_ACTIVE=prod
#   REDIS_HOST=your-db-12345.upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=your-upstash-token
# Connection pool (HikariCP) is pre-tuned for Neon; override only if needed:
# DB_POOL_MAX=10
# DB_POOL_MIN_IDLE=2

# --- Object storage: local filesystem (default) or S3-compatible (e.g. Cloudflare R2) ---
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=/var/claimlens/documents
STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=your-bucket-name
STORAGE_S3_ACCESS_KEY=your-r2-access-key-id
STORAGE_S3_SECRET_KEY=your-r2-secret-key
STORAGE_S3_PUBLIC_URL=https://<hash>.r2.dev

# --- Email: log (default) | resend (HTTP API) | smtp (SMTP relay) ---
EMAIL_PROVIDER=log
EMAIL_FROM=Claimlens <noreply@your-verified-domain>
# Resend (EMAIL_PROVIDER=resend): create a key at resend.com, verify your sending domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP (EMAIL_PROVIDER=smtp):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-user
# MAIL_PASSWORD=your-smtp-app-password

# --- OCR (off -> stub). Provider when enabled: 'http' (Python ocr-service) or 'vision' (Google) ---
OCR_ENABLED=false
OCR_PROVIDER=http
OCR_SERVICE_URL=http://localhost:8000
# For OCR_PROVIDER=vision: a Cloud Vision API key (project must have billing enabled).
# GOOGLE_VISION_API_KEY=AIza...
# --- Analysis service (off -> stub) ---
ANALYSIS_ENABLED=false
ANALYSIS_SERVICE_URL=http://localhost:8001

# --- AI / RAG (off -> stub embeddings + extractive answers; true -> Gemini) ---
AI_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_CHAT_MODEL=gemini-2.5-flash   # 3-flash-preview free tier is only 20 requests/DAY

# --- RAG retrieval backend ---
# false -> in-Java cosine over embeddings stored as JSON text. Works on ANY Postgres (keep this
#          locally: stock Postgres has no `vector` extension).
# true  -> pgvector + HNSW index. Set this in DEPLOYED environments whose Postgres has the
#          extension (Neon does). Requires 768-dim embeddings, i.e. AI_ENABLED=true — the
#          AI_ENABLED=false stub is 256-dim and will not fit vector(768).
# Two things to know before switching it on:
#   1. A search failure returns EMPTY results; it does NOT fall back to the in-Java path.
#   2. It does not backfill — chunks ingested while it was off have a NULL vector and are
#      invisible to search. Ingest after enabling, or re-ingest.
PGVECTOR_ENABLED=false
