# Max upload size (MB).
MAX_UPLOAD_MB=25

# Perceptual-hash Hamming distance at/under which two images are "near-duplicates" (0-64 for 64-bit
# hashes). Lower = stricter. The backend uses this to flag reuse across claims.
DUPLICATE_HAMMING_THRESHOLD=8

# ORB similarity (0..1) at/above which two images are considered a strong visual match.
ORB_SIMILARITY_THRESHOLD=0.25

# Hours of clock skew tolerated before an EXIF capture time earlier than the incident date is called
# INCONSISTENT (cameras/timezones drift).
EXIF_SKEW_HOURS=24

# Kilometres between EXIF GPS and the reported incident location before it's called INCONSISTENT.
EXIF_GPS_KM_THRESHOLD=50

# Optional shared secret; if set, callers must send  X-ANALYSIS-TOKEN: <value>
# ANALYSIS_SHARED_SECRET=change-me
